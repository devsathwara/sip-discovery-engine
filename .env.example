# SQLite file used by Prisma. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# apify (default) calls logiover/reddit-search-scraper.
# fixture runs a labeled demo and does not contact Reddit or Apify.
REDDIT_PROVIDER=apify

# Server-side only. Create one at https://console.apify.com/account/integrations
# Ingestion also accepts APIFY_TOKEN as an alias of APIFY_API_TOKEN.
APIFY_API_TOKEN=

# YouTube Data API v3. Ingestion searches SIP videos, then reads commentThreads.
# A quota error stops with a message and keeps rows already saved.
YOUTUBE_API_KEY=

# grok uses the xAI API. fixture uses a labeled local word-list analyzer.
# huggingface uses the Hugging Face OpenAI-compatible router.
LLM_PROVIDER=grok
# Cheaper than grok-4.7 ($2/$6 per 1M tokens) and it does not bill reasoning tokens.
# xAI lists this model at $1.25 input and $2.50 output per 1M tokens under 200k.
LLM_MODEL=grok-4.20-0309-non-reasoning
XAI_API_KEY=
# Optional alias used when XAI_API_KEY is empty, or as the Hugging Face token.
LLM_API_KEY=

# Optional. When set, /api/discovery/* requires Authorization: Bearer <key>.
# The dashboard server actions stay on the server and do not put this key in the browser.
DISCOVERY_API_KEY=
