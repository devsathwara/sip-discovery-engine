{
  "name": "sip-discovery-engine",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "export:results": "node --env-file=.env --import tsx scripts/export-results.ts",
    "test": "prisma db push --skip-generate --accept-data-loss && vitest run",
    "ingest": "node --env-file=.env --import tsx scripts/ingest.ts",
    "classify:sample": "node --env-file=.env --import tsx scripts/classify-sample.ts",
    "classify:full": "node --env-file=.env --import tsx scripts/classify-full.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "google-play-scraper": "^10.1.4",
    "next": "16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.16.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
